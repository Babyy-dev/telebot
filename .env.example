# https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Your Telegram numeric ID (python login.py prints it)
ALERT_CHAT_ID=123456789

# Bot that DMs you with a real notification (from @BotFather)
# Open the bot in Telegram and tap Start once, then paste the token:
TELEGRAM_BOT_TOKEN=

# Private group ID from: python list_chats.py
MONITOR_CHANNELS=-1001234567890

# Notify intern/trainee OR remote
FILTER_ROLES=intern
FILTER_WORK_MODES=remote
FILTER_LOCATIONS=

# Used in email drafts
YOUR_NAME=Your Name

# Optional SMS (India) via https://www.fast2sms.com
# SMS_TO=91XXXXXXXXXX
# FAST2SMS_API_KEY=your_fast2sms_key
